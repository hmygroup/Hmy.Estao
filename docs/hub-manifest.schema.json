{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estao Hub catalog",
  "description": "Publish as hub-manifest.json at the root of hmygroup/hmy-prompt-engineer. Curation and metadata, not executable policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultLanguage", "categories"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "defaultLanguage": { "type": "string", "pattern": "^[a-z]{2}$" },
    "categories": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/translations" }
    },
    "skills": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/skill" } },
    "instructions": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/entry" } },
    "files": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/entry" } },
    "mcps": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/networkEntry" } },
    "clis": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/networkEntry" } }
  },
  "$defs": {
    "networkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "categories", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 5, "maxLength": 32767, "pattern": "^\\\\\\\\[^\\\\]+\\\\[^\\\\]+", "description": "UNC network-folder path. Syntax validated by Estao; never accessed during discovery." },
        "categories": { "type": "string", "maxLength": 4096 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S", "description": "Required English description, displayed unchanged in every UI language." }
      }
    },
    "entry": { "$ref": "#/$defs/entryFields", "unevaluatedProperties": false },
    "skill": {
      "$ref": "#/$defs/entryFields",
      "properties": {
        "dependencies": {
          "type": "array", "maxItems": 50, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" },
          "description": "Required catalog skill IDs. References and cycles are checked by Estao."
        }
      },
      "unevaluatedProperties": false
    },
    "entryFields": {
        "type": "object",
        "required": ["id", "path", "categories"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Repository-relative forward-slash path. Skill: whole folder containing SKILL.md. Other types: one file. Runtime validation rejects unsafe or overlapping paths; entries with missing source files are omitted individually."
          },
          "categories": {
            "type": "string",
            "maxLength": 4096,
            "description": "Comma-separated registered category IDs, or empty for Uncategorized. Whitespace is trimmed; repeated IDs are deduplicated."
          }
        }
    },
    "id": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "translations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "description": "Category labels keyed by lowercase ISO 639-1 language codes. The defaultLanguage translation is mandatory; runtime validation checks supported ISO codes."
    }
  }
}
