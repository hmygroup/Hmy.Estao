<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);WFO1000;CS8765</NoWarn>
    <AssemblyName>Zarpa.Controls.Net10</AssemblyName>
    <RootNamespace>ZarpaSuite.Controls</RootNamespace>
  </PropertyGroup>

  <!-- La fuente de verdad de los controles es el árbol Zarpa completo traído de TestRibbon. -->
  <ItemGroup>
    <Compile Remove="DesignSystem\**\*.cs" />
    <Compile Remove="Shell\**\*.cs" />
    <Compile Remove="Feedback\**\*.cs" />
    <Compile Remove="Inputs\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\TestRibbon\Zarpa.Controls\Assets\FluentIcons\FluentSystemIcons-Regular.ttf" Link="Assets\FluentIcons\FluentSystemIcons-Regular.ttf">
      <LogicalName>TestRibbon.Assets.FluentSystemIcons-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\TestRibbon\Zarpa.Controls\Assets\FluentIcons\FluentSystemIcons-Regular.json" Link="Assets\FluentIcons\FluentSystemIcons-Regular.json">
      <LogicalName>TestRibbon.Assets.FluentSystemIcons-Regular.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
